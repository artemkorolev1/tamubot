lightrag/storage/
lightrag/storage_*/
_archive/lightrag/storage*/

# --- Data folders: ignore everything by default, carve back the source-of-truth ---
# Rationale: data/ and tamu_data/ are for artifacts (golden sets, eval reports,
# scrape dumps). Code references a small set of canonical inputs — those are
# explicitly un-ignored below.
data/
tamu_data/**
!tamu_data/**/
!tamu_data/evals/eval_corpus.json
!tamu_data/evals/personas/**
!tamu_data/raw/simple_syllabus_metadata.json
!tamu_data/raw/simple_syllabus/*/graduate/*/metadata.json

# Debug output dumps (ad-hoc files generated during debugging sessions)
*_output.txt

# Streamlit
.streamlit/secrets.toml

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.bak

# Claude Code internal (keep skills — they're project-specific)
.claude/*
!.claude/skills/
.ccstatusline-settings.json
skills-lock.json

# auto-claude framework
.auto-claude/
.auto-claude-security.json

# Playwright MCP logs
.playwright-mcp/
.worktrees/

# One-off test scripts
test_hooks.sh

# Archived spikes and legacy code (kept locally for reference)
_archive/

# Personal tooling / notifications
.claude_notify.py
.dagster_home/

# Docker cache bind-mounts (host-side, regeneratable)
.docker-cache/
.beszel-data/

