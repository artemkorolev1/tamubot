# Auth — Claude Code OAuth token (uses your Max subscription, not a metered API key).
# Generate with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# IMPORTANT: ANTHROPIC_API_KEY must be UNSET. main.mts throws if it is present,
# because it would override the Max-subscription auth above. Do not set it here.

# GitHub personal access token — agents use it to read and manage GitHub Issues.
# Create a fine-grained token: https://github.com/settings/personal-access-tokens/new
# Required repository permissions: Issues (Read and write) and Metadata (Read).
GH_TOKEN=

# --- Optional overrides ---
# Per-role model selection (defaults shown):
# SANDCASTLE_PLANNER_MODEL=claude-opus-4-8
# SANDCASTLE_IMPLEMENTER_MODEL=claude-sonnet-4-6
# SANDCASTLE_REVIEWER_MODEL=claude-sonnet-4-6
# SANDCASTLE_MERGER_MODEL=claude-opus-4-8
#
# SANDCASTLE_ALLOW_DIRTY=1               # run despite a dirty working tree
# SANDCASTLE_MAX_RUNTIME_MS=5400000      # hard wall-clock cap (default 90 min)
# SANDCASTLE_IMPLEMENTER_MAX_ITERATIONS=30
